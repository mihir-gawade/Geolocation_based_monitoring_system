<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/live_tracking_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Google Map Fragment -->
    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Refresh Location Button -->
    <Button
        android:id="@+id/btn_refresh_location"
        android:layout_width="125dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="80dp"
        android:text="Refresh Location" />

    <!-- Attendance Buttons -->
    <LinearLayout
        android:id="@+id/attendance_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:layout_marginBottom="16dp"
        android:padding="8dp"
        android:background="#66000000">

        <Button
            android:id="@+id/btn_mark_in"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mark In (9 AM)" />

        <Space
            android:layout_width="16dp"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btn_mark_out"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mark Out (5 PM)" />
    </LinearLayout>

    <!-- Status Text -->
    <TextView
        android:id="@+id/location_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:background="#66000000"
        android:padding="8dp"
        android:text="Locating employee..."
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

</FrameLayout>